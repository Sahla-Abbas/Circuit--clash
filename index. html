<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="theme-color" content="#07111b">
<title>Circuit Clash: Electronics Quiz Duel</title>

<style>
/* =========================================================
   CIRCUIT CLASH — Mobile-first circuit board theme
   All styling is contained in this file.
   ========================================================= */

:root {
  --bg: #07111b;
  --panel: #0d1c29;
  --panel-light: #122637;
  --green: #42ff9e;
  --blue: #39c8ff;
  --red: #ff536b;
  --yellow: #ffe47a;
  --text: #ecf7ff;
  --muted: #91a9ba;
  --border: rgba(110, 200, 235, .2);
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html, body {
  margin: 0;
  width: 100%;
  min-height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
}

body {
  min-height: 100dvh;
  overflow-x: hidden;
  background-image:
    linear-gradient(rgba(57,200,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(57,200,255,.035) 1px, transparent 1px);
  background-size: 24px 24px;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
  touch-action: manipulation;
}

button:focus-visible, input:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 3px;
}

.hidden {
  display: none !important;
}

.screen {
  width: 100%;
  min-height: 100dvh;
  padding: 20px 14px;
  animation: appear .35s ease both;
}

@keyframes appear {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .55; }
}

@keyframes pop {
  0% { transform: scale(.96); }
  65% { transform: scale(1.02); }
  100% { transform: scale(1); }
}

@keyframes glow {
  0%, 100% { box-shadow: 0 0 10px rgba(66,255,158,.08); }
  50% { box-shadow: 0 0 25px rgba(66,255,158,.18); }
}

.brand {
  text-align: center;
  margin: 12px auto 26px;
}

.chip-icon {
  display: inline-grid;
  place-items: center;
  width: 65px;
  height: 65px;
  border: 2px solid var(--green);
  border-radius: 17px;
  color: var(--green);
  font-size: 29px;
  background: #0a201c;
  box-shadow: 0 0 24px rgba(66,255,158,.14);
  margin-bottom: 12px;
}

.brand h1 {
  margin: 0;
  font-size: clamp(25px, 7vw, 38px);
  line-height: 1.12;
  letter-spacing: -1px;
}

.brand h1 span {
  color: var(--green);
}

.subtitle {
  color: var(--muted);
  font-size: 13px;
  margin-top: 9px;
}

.panel {
  background: rgba(13, 28, 41, .95);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 19px;
  box-shadow: 0 10px 35px rgba(0,0,0,.15);
}

.section-title {
  font-size: 12px;
  letter-spacing: 2px;
  color: var(--blue);
  font-weight: 800;
  text-transform: uppercase;
  margin: 0 0 14px;
}

.field-label {
  display: block;
  font-size: 12px;
  color: var(--muted);
  margin: 0 0 7px;
}

.name-field {
  width: 100%;
  min-height: 49px;
  padding: 12px 14px;
  color: var(--text);
  background: #07141f;
  border: 1px solid var(--border);
  border-radius: 11px;
  margin-bottom: 15px;
}

.name-field::placeholder {
  color: #647e90;
}

.how-list {
  padding-left: 20px;
  margin: 0;
  color: #c0d3df;
  font-size: 13px;
  line-height: 1.9;
}

.how-list li::marker {
  color: var(--green);
}

.primary-btn {
  width: 100%;
  min-height: 54px;
  border: 0;
  border-radius: 13px;
  margin-top: 19px;
  padding: 14px 18px;
  color: #03120d;
  background: linear-gradient(110deg, var(--green), #8affc3);
  font-size: 15px;
  font-weight: 900;
  letter-spacing: .5px;
  box-shadow: 0 5px 22px rgba(66,255,158,.15);
  transition: transform .15s, filter .15s;
}

.primary-btn:active {
  transform: scale(.98);
}

.secondary-btn {
  width: 100%;
  min-height: 48px;
  border-radius: 12px;
  color: var(--blue);
  background: transparent;
  border: 1px solid var(--border);
  margin-top: 10px;
  font-weight: 750;
}

.footer-note {
  color: #698396;
  text-align: center;
  font-size: 11px;
  margin-top: 18px;
}

/* Game header */
.game-screen {
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.game-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  padding: 3px 2px;
}

.mini-brand {
  font-weight: 900;
  font-size: 14px;
  letter-spacing: .5px;
}

.mini-brand span {
  color: var(--green);
}

.round-label {
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
}

.progress-track {
  height: 4px;
  border-radius: 5px;
  overflow: hidden;
  background: #1b3040;
}

.progress-fill {
  width: 0;
  height: 100%;
  background: var(--green);
  transition: width .3s ease;
}

.question-panel {
  padding: 14px;
  text-align: center;
}

.topic-pill {
  display: inline-block;
  border: 1px solid rgba(57,200,255,.35);
  color: var(--blue);
  background: rgba(57,200,255,.07);
  border-radius: 30px;
  padding: 5px 11px;
  font-size: 10px;
  letter-spacing: 1px;
  font-weight: 850;
  text-transform: uppercase;
}

.question-text {
  margin: 12px 0 14px;
  font-size: clamp(17px, 4.7vw, 22px);
  line-height: 1.38;
  font-weight: 800;
}

.timer-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: var(--muted);
  font-size: 11px;
}

.timer-ring {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid var(--green);
  color: var(--green);
  font-weight: 900;
  font-size: 16px;
  transition: border-color .2s, color .2s;
}

.timer-ring.urgent {
  border-color: var(--red);
  color: var(--red);
  animation: pulse .5s infinite;
}

/* Portrait: players occupy the top and bottom halves.
   Landscape/wide screens: players occupy left and right halves. */
.duel-board {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 10px;
}

.player-card {
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 11px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: rgba(13,28,41,.97);
  transition: border-color .2s, background .2s;
  overflow: hidden;
}

.player-card.p1 {
  border-top: 2px solid var(--green);
}

.player-card.p2 {
  border-top: 2px solid var(--blue);
}

.player-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 8px;
}

.player-name {
  font-size: 13px;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p1 .player-name, .p1 .score {
  color: var(--green);
}

.p2 .player-name, .p2 .score {
  color: var(--blue);
}

.player-meta {
  display: flex;
  align-items: center;
  gap: 8px;
}

.score {
  font-weight: 900;
  font-size: 16px;
  font-variant-numeric: tabular-nums;
}

.answer-status {
  color: var(--muted);
  font-size: 10px;
  text-align: right;
  min-height: 15px;
  margin-bottom: 6px;
}

.answer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  flex: 1;
  min-height: 0;
}

.answer-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  min-width: 0;
  min-height: 40px;
  padding: 9px 8px;
  color: #d7e7f0;
  background: #102535;
  border: 1px solid rgba(135,184,207,.17);
  border-radius: 10px;
  text-align: left;
  font-size: clamp(11px, 3vw, 14px);
  line-height: 1.25;
  font-weight: 650;
  overflow-wrap: anywhere;
  transition: background .18s, border-color .18s, transform .18s;
}

.answer-btn:active:not(:disabled) {
  transform: scale(.97);
}

.option-letter {
  display: grid;
  flex-shrink: 0;
  place-items: center;
  width: 23px;
  height: 23px;
  border-radius: 7px;
  color: #9bb5c6;
  background: #203849;
  font-size: 10px;
  font-weight: 900;
}

.answer-btn:disabled {
  cursor: default;
  opacity: .8;
}

.answer-btn.selected-correct {
  color: #03170d;
  background: var(--green);
  border-color: var(--green);
  opacity: 1;
}

.answer-btn.selected-wrong {
  color: white;
  background: #5d2330;
  border-color: var(--red);
  opacity: 1;
}

.answer-btn.reveal-correct {
  border: 2px solid var(--green);
}

.answer-btn.selected-correct .option-letter {
  color: #03170d;
  background: rgba(0,0,0,.1);
}

.feedback {
  margin-top: 8px;
  min-height: 20px;
  font-size: 11px;
  font-weight: 800;
}

.feedback.good { color: var(--green); }
.feedback.bad { color: var(--red); }
.feedback.neutral { color: var(--yellow); }

.explanation {
  display: none;
  padding: 11px 12px;
  background: rgba(57,200,255,.07);
  border: 1px solid rgba(57,200,255,.17);
  border-radius: 11px;
  color: #c5dce9;
  font-size: 12px;
  line-height: 1.5;
}

.explanation.visible {
  display: block;
  animation: appear .25s ease both;
}

.next-row {
  display: flex;
  gap: 10px;
  align-items: center;
  justify-content: space-between;
  padding: 0 2px;
}

.next-note {
  color: var(--muted);
  font-size: 11px;
}

.next-btn {
  min-height: 42px;
  padding: 10px 17px;
  color: #03120d;
  background: var(--green);
  border: 0;
  border-radius: 10px;
  font-weight: 900;
  font-size: 12px;
}

.next-btn:disabled {
  opacity: .45;
  cursor: default;
}

/* Results */
.result-hero {
  text-align: center;
  padding: 28px 15px;
}

.trophy {
  font-size: 48px;
  margin-bottom: 10px;
}

.result-hero h2 {
  font-size: 29px;
  margin: 0 0 7px;
}

.result-hero p {
  color: var(--muted);
  font-size: 13px;
  margin: 0;
}

.result-score-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 18px;
}

.result-score {
  text-align: center;
  padding: 20px 10px;
  background: #0d1c29;
  border: 1px solid var(--border);
  border-radius: 15px;
}

.result-score .big-score {
  font-size: 32px;
  font-weight: 950;
  margin: 8px 0;
}

.result-score .result-name {
  color: var(--muted);
  font-size: 12px;
  overflow-wrap: anywhere;
}

.result-score.p1 .big-score { color: var(--green); }
.result-score.p2 .big-score { color: var(--blue); }

.stat-line {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 11px 0;
  border-bottom: 1px solid var(--border);
  font-size: 13px;
}

.stat-line:last-child { border-bottom: 0; }
.stat-line span:first-child { color: var(--muted); }

.history {
  margin-top: 18px;
}

.history-item {
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  line-height: 1.5;
}

.history-item:last-child { border-bottom: 0; }

@media (orientation: landscape) and (min-width: 650px) {
  .game-screen {
    height: 100dvh;
    overflow: hidden;
  }

  .duel-board {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr;
  }

  .player-card {
    padding: 13px;
  }

  .answer-btn {
    font-size: 14px;
  }

  .question-panel {
    padding: 10px;
  }

  .question-text {
    margin: 7px 0;
  }

  .timer-ring {
    width: 32px;
    height: 32px;
  }
}

@media (max-height: 680px) and (orientation: portrait) {
  .game-screen { gap: 6px; padding: 7px; }
  .question-panel { padding: 8px 10px; }
  .question-text { margin: 7px 0; font-size: 16px; }
  .timer-ring { width: 30px; height: 30px; font-size: 13px; }
  .player-card { padding: 8px; }
  .answer-grid { gap: 5px; }
  .answer-btn { padding: 6px; min-height: 32px; }
  .option-letter { width: 19px; height: 19px; }
  .feedback { margin-top: 4px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}
</style>
</head>

<body>

<!-- START SCREEN -->
<main id="startScreen" class="screen">
  <header class="brand">
    <div class="chip-icon" aria-hidden="true">⌘</div>
    <h1>CIRCUIT <span>CLASH</span></h1>
    <div class="subtitle">ELECTRONICS QUIZ DUEL · TWO PLAYERS · 10 ROUNDS</div>
  </header>

  <section class="panel">
    <h2 class="section-title">01 / Identify Players</h2>

    <label class="field-label" for="player1Input">PLAYER 1 — GREEN</label>
    <input class="name-field" id="player1Input" maxlength="18"
           placeholder="Enter Player 1 name" value="Player 1">

    <label class="field-label" for="player2Input">PLAYER 2 — BLUE</label>
    <input class="name-field" id="player2Input" maxlength="18"
           placeholder="Enter Player 2 name" value="Player 2">
  </section>

  <section class="panel" style="margin-top:14px">
    <h2 class="section-title">02 / How to Play</h2>
    <ol class="how-list">
      <li>Both players get the same question simultaneously.</li>
      <li>Each player taps an answer on their own half of the screen.</li>
      <li>Correct answers earn points based on response speed.</li>
      <li>Faster correct answers earn more: up to 100 points.</li>
      <li>Wrong answers earn 0 points. No answer in 10 seconds earns 0.</li>
      <li>Read the explanation after each round and learn as you play!</li>
    </ol>
    <button class="primary-btn" id="startBtn">⚡ START THE DUEL</button>
  </section>

  <p class="footer-note">40+ QUESTIONS · RANDOMIZED ROUNDS · NO INTERNET NEEDED</p>
</main>

<!-- GAME SCREEN -->
<main id="gameScreen" class="screen game-screen hidden">
  <header class="game-header">
    <div class="mini-brand">CIRCUIT <span>CLASH</span></div>
    <div class="round-label" id="roundLabel">ROUND 1 / 10</div>
  </header>

  <div class="progress-track" aria-label="Game progress">
    <div class="progress-fill" id="progressFill"></div>
  </div>

  <section class="panel question-panel">
    <div class="topic-pill" id="topicLabel">OHM'S LAW</div>
    <h2 class="question-text" id="questionText">Question appears here.</h2>
    <div class="timer-row">
      <div class="timer-ring" id="timerRing">10</div>
      <span id="timerMessage">Answer before time runs out</span>
    </div>
  </section>

  <section class="duel-board">
    <!-- Player 1: top in portrait, left in landscape -->
    <article class="player-card p1" id="player1Card">
      <header class="player-head">
        <div class="player-name" id="player1Name">Player 1</div>
        <div class="player-meta">
          <span class="score" id="player1Score">0 pts</span>
        </div>
      </header>
      <div class="answer-status" id="player1Status">Choose your answer</div>
      <div class="answer-grid" id="player1Answers"></div>
      <div class="feedback" id="player1Feedback" aria-live="polite"></div>
    </article>

    <!-- Player 2: bottom in portrait, right in landscape -->
    <article class="player-card p2" id="player2Card">
      <header class="player-head">
        <div class="player-name" id="player2Name">Player 2</div>
        <div class="player-meta">
          <span class="score" id="player2Score">0 pts</span>
        </div>
      </header>
      <div class="answer-status" id="player2Status">Choose your answer</div>
      <div class="answer-grid" id="player2Answers"></div>
      <div class="feedback" id="player2Feedback" aria-live="polite"></div>
    </article>
  </section>

  <section class="explanation" id="explanation" aria-live="polite"></section>

  <footer class="next-row">
    <div class="next-note" id="nextNote">Both players can answer now.</div>
    <button class="next-btn" id="nextBtn" disabled>Next →</button>
  </footer>
</main>

<!-- RESULTS SCREEN -->
<main id="resultsScreen" class="screen hidden">
  <header class="brand" style="margin-bottom:10px">
    <div class="chip-icon" aria-hidden="true">⚡</div>
    <h1>DUEL <span>COMPLETE</span></h1>
    <div class="subtitle">FINAL RESULTS · 10 ROUNDS</div>
  </header>

  <section class="panel result-hero">
    <div class="trophy" id="resultTrophy">🏆</div>
    <h2 id="winnerText">Winner!</h2>
    <p id="winnerSubtitle">The circuit champion has been decided.</p>
  </section>

  <section class="result-score-grid">
    <article class="result-score p1">
      <div class="result-name" id="resultPlayer1">Player 1</div>
      <div class="big-score" id="resultScore1">0</div>
      <div class="result-name">POINTS</div>
    </article>
    <article class="result-score p2">
      <div class="result-name" id="resultPlayer2">Player 2</div>
      <div class="big-score" id="resultScore2">0</div>
      <div class="result-name">POINTS</div>
    </article>
  </section>

  <section class="panel" style="margin-top:15px">
    <h2 class="section-title">Performance Report</h2>
    <div class="stat-line">
      <span id="statLabel1">Player 1 correct answers</span>
      <strong id="statCorrect1">0 / 10</strong>
    </div>
    <div class="stat-line">
      <span id="statLabel2">Player 2 correct answers</span>
      <strong id="statCorrect2">0 / 10</strong>
    </div>
    <div class="stat-line">
      <span>Fastest correct response</span>
      <strong id="fastestResponse">—</strong>
    </div>
    <div class="stat-line">
      <span>Questions played</span>
      <strong>10 / 10</strong>
    </div>
  </section>

  <section class="panel history">
    <h2 class="section-title">Round Review</h2>
    <div id="roundHistory"></div>
  </section>

  <button class="primary-btn" id="playAgainBtn">↻ PLAY AGAIN</button>
  <button class="secondary-btn" id="homeBtn">Back to Start</button>
</main>

<script>
"use strict";

/* =========================================================
   QUESTION BANK
   Edit this array to add, remove or modify questions.
   correct = zero-based index of the correct option.
   Each question must have: topic, q, options, correct, why.
   Keep exactly four options per question.
   ========================================================= */

const QUESTIONS = [
  // RESISTOR COLOUR CODES
  {
    topic: "Resistor Colour Code",
    q: "In a 4-band resistor, what digit does RED represent?",
    options: ["1", "2", "3", "4"],
    correct: 1,
    why: "The standard colour sequence begins Black 0, Brown 1, Red 2, Orange 3, and Yellow 4."
  },
  {
    topic: "Resistor Colour Code",
    q: "What is the multiplier for the GOLD band?",
    options: ["× 0.1", "× 1", "× 10", "× 0.01"],
    correct: 0,
    why: "Gold is a multiplier of 0.1, meaning the resistance value is multiplied by one-tenth."
  },
  {
    topic: "Resistor Colour Code",
    q: "What is the resistance of Brown–Black–Red–Gold?",
    options: ["100 Ω", "1 kΩ", "10 kΩ", "100 kΩ"],
    correct: 1,
    why: "Brown = 1, Black = 0, and Red is ×100. So 10 × 100 = 1,000 Ω. Gold indicates ±5% tolerance."
  },
  {
    topic: "Resistor Colour Code",
    q: "Which colour represents the digit 5?",
    options: ["Green", "Blue", "Violet", "Grey"],
    correct: 0,
    why: "The resistor digit sequence assigns Green = 5, Blue = 6, Violet = 7, Grey = 8, and White = 9."
  },
  {
    topic: "Resistor Colour Code",
    q: "What tolerance does a GOLD band indicate?",
    options: ["±1%", "±2%", "±5%", "±10%"],
    correct: 2,
    why: "Gold indicates a tolerance of ±5%; silver indicates ±10%."
  },
  {
    topic: "Resistor Colour Code",
    q: "What is the value of Red–Red–Brown–Gold?",
    options: ["22 Ω", "220 Ω", "2.2 kΩ", "22 kΩ"],
    correct: 1,
    why: "The first two digits are 2 and 2. Brown multiplies by 10, giving 22 × 10 = 220 Ω."
  },
  {
    topic: "Resistor Colour Code",
    q: "Which colour represents zero in a resistor code?",
    options: ["Brown", "Black", "Silver", "White"],
    correct: 1,
    why: "Black represents the digit 0."
  },
  {
    topic: "Resistor Colour Code",
    q: "What is the resistance of Yellow–Violet–Orange?",
    options: ["47 Ω", "470 Ω", "4.7 kΩ", "47 kΩ"],
    correct: 3,
    why: "Yellow = 4, Violet = 7, Orange = ×1,000. Therefore 47 × 1,000 = 47 kΩ."
  },

  // OHM'S LAW AND DC CIRCUITS
  {
    topic: "Ohm's Law",
    q: "What is Ohm's law?",
    options: ["V = IR", "P = I/R", "I = VR", "R = VI"],
    correct: 0,
    why: "Ohm's law states that voltage equals current multiplied by resistance: V = IR."
  },
  {
    topic: "Ohm's Law",
    q: "A 12 V supply is connected across 6 Ω. What current flows?",
    options: ["0.5 A", "2 A", "6 A", "72 A"],
    correct: 1,
    why: "Using I = V/R, current = 12/6 = 2 A."
