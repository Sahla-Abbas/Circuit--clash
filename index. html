/* =========================================================
   GAME STATE
   ========================================================= */

const TOTAL_ROUNDS = 10;
const ROUND_SECONDS = 10;

const $ = id => document.getElementById(id);

const state = {
  names: ["Player 1", "Player 2"],
  scores: [0, 0],
  correctCounts: [0, 0],
  answers: [null, null],
  round: 0,
  questions: [],
  roundStartedAt: 0,
  timerInterval: null,
  deadlineTimeout: null,
  roundLocked: false,
  history: [],
  fastest: null,
  audioContext: null
};

/* =========================================================
   AUDIO FEEDBACK — Web Audio API, no sound files needed.
   Browsers usually require a user gesture before audio starts.
   ========================================================= */

function playTone(kind) {
  try {
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtx) return;

    if (!state.audioContext) {
      state.audioContext = new AudioCtx();
    }

    const ctx = state.audioContext;
    if (ctx.state === "suspended") ctx.resume();

    const now = ctx.currentTime;
    const oscillator = ctx.createOscillator();
    const gain = ctx.createGain();

    oscillator.connect(gain);
    gain.connect(ctx.destination);

    if (kind === "correct") {
      oscillator.type = "sine";
      oscillator.frequency.setValueAtTime(660, now);
      oscillator.frequency.setValueAtTime(880, now + 0.09);
      gain.gain.setValueAtTime(0.12, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
      oscillator.start(now);
      oscillator.stop(now + 0.23);
    } else if (kind === "wrong") {
      oscillator.type = "triangle";
      oscillator.frequency.setValueAtTime(240, now);
      oscillator.frequency.exponentialRampToValueAtTime(140, now + 0.16);
      gain.gain.setValueAtTime(0.10, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);
      oscillator.start(now);
      oscillator.stop(now + 0.19);
    } else {
      oscillator.type = "sine";
      oscillator.frequency.setValueAtTime(440, now);
      gain.gain.setValueAtTime(0.08, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
      oscillator.start(now);
      oscillator.stop(now + 0.13);
    }
  } catch (error) {
    // Audio is optional; gameplay still works if audio is unavailable.
  }
}

/* =========================================================
   GAME INITIALIZATION
   ========================================================= */

function shuffle(array) {
  const copy = [...array];

  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }

  return copy;
}

function startGame() {
  if (QUESTIONS.length < TOTAL_ROUNDS) {
    alert("Add at least 10 questions to the QUESTIONS array.");
    return;
  }

  // Read names and prevent blank player labels.
  state.names = [
    $("player1Input").value.trim() || "Player 1",
    $("player2Input").value.trim() || "Player 2"
  ];

  // Reset every game statistic.
  state.scores = [0, 0];
  state.correctCounts = [0, 0];
  state.answers = [null, null];
  state.round = 0;
  state.history = [];
  state.fastest = null;
  state.roundLocked = false;

  clearRoundTimers();

  // Select 10 distinct questions for this game.
  state.questions = shuffle(QUESTIONS).slice(0, TOTAL_ROUNDS);

  $("startScreen").classList.add("hidden");
  $("resultsScreen").classList.add("hidden");
  $("gameScreen").classList.remove("hidden");

  $("player1Name").textContent = state.names[0];
  $("player2Name").textContent = state.names[1];

  renderRound();
}

function clearRoundTimers() {
  clearInterval(state.timerInterval);
  clearTimeout(state.deadlineTimeout);
  state.timerInterval = null;
  state.deadlineTimeout = null;
}

/* =========================================================
   ROUND RENDERING
   ========================================================= */

function renderRound() {
  clearRoundTimers();

  state.roundLocked = false;
  state.answers = [null, null];

  const question = state.questions[state.round];

  $("roundLabel").textContent =
    `ROUND ${state.round + 1} / ${TOTAL_ROUNDS}`;

  $("progressFill").style.width =
    `${(state.round / TOTAL_ROUNDS) * 100}%`;

  $("topicLabel").textContent = question.topic;
  $("questionText").textContent = question.q;

  $("timerRing").textContent = ROUND_SECONDS;
  $("timerRing").classList.remove("urgent");
  $("timerMessage").textContent = "Answer before time runs out";

  $("explanation").textContent = "";
  $("explanation").classList.remove("visible");

  $("nextNote").textContent = "Both players can answer now.";
  $("nextBtn").disabled = true;
  $("nextBtn").textContent =
    state.round === TOTAL_ROUNDS - 1 ? "Results →" : "Next →";

  for (let p = 0; p < 2; p++) {
    $(`player${p + 1}Score`).textContent =
      `${state.scores[p]} pts`;

    $(`player${p + 1}Status`).textContent = "Choose your answer";
    $(`player${p + 1}Feedback`).textContent = "";
    $(`player${p + 1}Feedback`).className = "feedback";

    const container = $(`player${p + 1}Answers`);
    container.replaceChildren();

    question.options.forEach((option, index) => {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "answer-btn";

      const letter = document.createElement("span");
      letter.className = "option-letter";
      letter.textContent = String.fromCharCode(65 + index);

      const text = document.createElement("span");
      text.textContent = option;

      button.append(letter, text);

      // Each player can only select from their own answer grid.
      button.addEventListener("click", () => submitAnswer(p, index));

      container.appendChild(button);
    });
  }

  state.roundStartedAt = performance.now();

  // A single shared deadline prevents the second player getting
  // extra time after the first player has answered.
  state.timerInterval = setInterval(updateTimer, 100);
  state.deadlineTimeout = setTimeout(endRound, ROUND_SECONDS * 1000);
}

function updateTimer() {
  if (state.roundLocked) return;

  const elapsed = (performance.now() - state.roundStartedAt) / 1000;
  const remaining = Math.max(0, ROUND_SECONDS - elapsed);
  const display = Math.ceil(remaining);

  $("timerRing").textContent = display;

  if (remaining <= 3) {
    $("timerRing").classList.add("urgent");
    $("timerMessage").textContent = "Hurry!";
  } else {
    $("timerRing").classList.remove("urgent");
  }
}

/* =========================================================
   ANSWER SUBMISSION AND SCORING
   ========================================================= */

function submitAnswer(playerIndex, optionIndex) {
  if (state.roundLocked || state.answers[playerIndex] !== null) {
    return;
  }

  const question = state.questions[state.round];
  const elapsed = Math.max(
    0,
    (performance.now() - state.roundStartedAt) / 1000
  );

  const correct = optionIndex === question.correct;

  // Scoring: 100 points at the start, falling linearly to 10
  // points at the 10-second deadline. Wrong answers score 0.
  let points = 0;

  if (correct) {
    const speedFraction = Math.max(
      0,
      Math.min(1, 1 - elapsed / ROUND_SECONDS)
    );

    points = Math.round(10 + 90 * speedFraction);
    state.scores[playerIndex] += points;
    state.correctCounts[playerIndex]++;
  }

  state.answers[playerIndex] = {
    optionIndex,
    correct,
    points,
    elapsed
  };

  if (correct) {
    playTone("correct");

    if (!state.fastest || elapsed < state.fastest.elapsed) {
      state.fastest = {
        player: playerIndex,
        elapsed,
        round: state.round + 1
      };
    }
  } else {
    playTone("wrong");
  }

  updatePlayerFeedback(playerIndex);

  // Once both have answered, reveal the solution immediately.
  if (state.answers.every(answer => answer !== null)) {
    endRound();
  }
}

function updatePlayerFeedback(playerIndex) {
  const answer = state.answers[playerIndex];
  const card = $(`player${playerIndex + 1}Card`);
  const feedback = $(`player${playerIndex + 1}Feedback`);
  const status = $(`player${playerIndex + 1}Status`);
  const buttons = $(`player${playerIndex + 1}Answers`).querySelectorAll("button");

  buttons.forEach((button, index) => {
    button.disabled = true;

    if (index === answer.optionIndex) {
      button.classList.add(
        answer.correct ? "selected-correct" : "selected-wrong"
      );
    }
  });

  if (answer.correct) {
    feedback.textContent = `✓ CORRECT  +${answer.points} PTS`;
    feedback.className = "feedback good";
    status.textContent = `Answered in ${answer.elapsed.toFixed(2)}s`;
  } else {
    feedback.textContent = "✕ WRONG  +0 PTS";
    feedback.className = "feedback bad";
    status.textContent = "Answer locked";
  }

  $(`player${playerIndex + 1}Score`).textContent =
    `${state.scores[playerIndex]} pts`;

  card.style.animation = "pop .25s ease";
  setTimeout(() => {
    card.style.animation = "";
  }, 280);
}

/* =========================================================
   ROUND COMPLETION
   ========================================================= */

function endRound() {
  if (state.roundLocked) return;

  state.roundLocked = true;
  clearRoundTimers();

  const question = state.questions[state.round];

  // Any player who did not answer receives zero points.
  for (let p = 0; p < 2; p++) {
    if (state.answers[p] === null) {
      state.answers[p] = {
        optionIndex: null,
        correct: false,
        points: 0,
        elapsed: ROUND_SECONDS,
        timeout: true
      };

      $(`player${p + 1}Status`).textContent = "Time expired";
      $(`player${p + 1}Feedback`).textContent = "⌛ TIME UP  +0 PTS";
      $(`player${p + 1}Feedback`).className = "feedback neutral";

      $(`player${p + 1}Answers`)
        .querySelectorAll("button")
        .forEach(button => button.disabled = true);
    }
  }

  // Reveal the correct answer to both players.
  for (let p = 0; p < 2; p++) {
    const buttons = $(`player${p + 1}Answers`).querySelectorAll("button");
    buttons[question.correct].classList.add("reveal-correct");
  }

  $("timerRing").textContent = "✓";
  $("timerMessage").textContent = "Round complete";

  $("explanation").textContent =
    `WHY THIS IS CORRECT: ${question.why}`;

  $("explanation").classList.add("visible");

  $("progressFill").style.width =
    `${((state.round + 1) / TOTAL_ROUNDS) * 100}%`;

  state.history.push({
    question: question.q,
    topic: question.topic,
    correctAnswer: question.options[question.correct],
    answers: state.answers.map(a => ({ ...a })),
    scores: [...state.scores]
  });

  $("nextNote").textContent =
    state.round === TOTAL_ROUNDS - 1
      ? "All 10 rounds completed."
      : "Review the explanation before continuing.";

  $("nextBtn").disabled = false;

  if (state.round === TOTAL_ROUNDS - 1) {
    $("nextBtn").textContent = "View Results →";
  }
}

function nextRound() {
  if (!state.roundLocked) return;

  if (state.round >= TOTAL_ROUNDS - 1) {
    showResults();
    return;
  }

  state.round++;
  renderRound();
}

/* =========================================================
   RESULTS
   ========================================================= */

function showResults() {
  clearRoundTimers();

  $("gameScreen").classList.add("hidden");
  $("resultsScreen").classList.remove("hidden");

  $("resultPlayer1").textContent = state.names[0];
  $("resultPlayer2").textContent = state.names[1];

  $("resultScore1").textContent = state.scores[0];
  $("resultScore2").textContent = state.scores[1];

  $("statLabel1").textContent = `${state.names[0]} correct answers`;
  $("statLabel2").textContent = `${state.names[1]} correct answers`;

  $("statCorrect1").textContent = `${state.correctCounts[0]} / 10`;
  $("statCorrect2").textContent = `${state.correctCounts[1]} / 10`;

  if (state.scores[0] > state.scores[1]) {
    $("winnerText").textContent = `${state.names[0]} Wins!`;
    $("winnerSubtitle").textContent = "Excellent speed and electronics knowledge.";
    $("resultTrophy").textContent = "🏆";
  } else if (state.scores[1] > state.scores[0]) {
    $("winnerText").textContent = `${state.names[1]} Wins!`;
    $("winnerSubtitle").textContent = "Excellent speed and electronics knowledge.";
    $("resultTrophy").textContent = "🏆";
  } else {
    $("winnerText").textContent = "It's a Draw!";
    $("winnerSubtitle").textContent = "Both players finished with the same score.";
    $("resultTrophy").textContent = "⚡";
  }

  if (state.fastest) {
    $("fastestResponse").textContent =
      `${state.names[state.fastest.player]} · ` +
      `${state.fastest.elapsed.toFixed(2)}s (R${state.fastest.round})`;
  } else {
    $("fastestResponse").textContent = "No correct answers";
  }

  const historyContainer = $("roundHistory");
  historyContainer.replaceChildren();

  state.history.forEach((entry, index) => {
    const row = document.createElement("div");
    row.className = "history-item";

    const title = document.createElement("strong");
    title.textContent = `${index + 1}. ${entry.topic}`;

    const question = document.createElement("div");
    question.textContent = entry.question;
    question.style.margin = "4px 0";

    const answer = document.createElement("div");
    answer.style.color = "var(--green)";
    answer.textContent = `Correct answer: ${entry.correctAnswer}`;

    const scores = document.createElement("div");
    scores.style.color = "var(--muted)";
    scores.textContent =
      `${state.names[0]}: ${entry.answers[0].points} pts · ` +
      `${state.names[1]}: ${entry.answers[1].points} pts`;

    row.append(title, question, answer, scores);
    historyContainer.appendChild(row);
  });
}

function backToStart() {
  clearRoundTimers();

  $("resultsScreen").classList.add("hidden");
  $("gameScreen").classList.add("hidden");
  $("startScreen").classList.remove("hidden");
}

/* =========================================================
   EVENT LISTENERS
   ========================================================= */

$("startBtn").addEventListener("click", startGame);
$("nextBtn").addEventListener("click", nextRound);
$("playAgainBtn").addEventListener("click", startGame);
$("homeBtn").addEventListener("click", backToStart);

// Prevent Enter from submitting anything unexpectedly.
document.querySelectorAll("input").forEach(input => {
  input.addEventListener("keydown", event => {
    if (event.key === "Enter") {
      event.preventDefault();
      input.blur();
    }
  });
});
</script>

